{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "天龙资产台",
  "version": "0.1.0",
  "identifier": "app.tlbb.explorer",
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "天龙八部·归来 — 资产理解工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
